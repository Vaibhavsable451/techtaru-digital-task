# Copy this file to .env and fill in your real keys. Never commit .env.

# Required: used for embeddings (Groq has no embeddings API)
OPENAI_API_KEY=your_openrouter_api_key_here

# Required only if you use Groq to write answers
GROQ_API_KEY=your_groq_api_key_here

GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Optional: default provider for answers ("groq" or "openai")
LLM_PROVIDER=groq

# Optional model overrides
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
